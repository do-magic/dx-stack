{
  "name": "@dxs/next-skaffold",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Sebastian Velten <velten.seb@web.de>",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dxs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json",
    "LICENSE"
  ],
  "nx": {
    "name": "next-skaffold",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/next-skaffold/dist",
          "main": "packages/next-skaffold/src/index.ts",
          "tsConfig": "packages/next-skaffold/tsconfig.lib.json",
          "rootDir": "packages/next-skaffold/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/next-skaffold/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/next-skaffold/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "23.1.1",
    "tslib": "^2.3.0",
    "@dxs/skaffold": "workspace:*",
    "@types/ejs": "^3.1.5",
    "ejs": "^6.0.1",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "nx": "^23.0.0"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "generators": "./generators.json"
}
