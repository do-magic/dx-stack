{
  "name": "@dxs/next-skaffold",
  "version": "0.0.1",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dxs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json"
  ],
  "nx": {
    "name": "next-skaffold",
    "sourceRoot": "packages/next-skaffold/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/next-skaffold/dist",
          "main": "packages/next-skaffold/src/index.ts",
          "tsConfig": "packages/next-skaffold/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true,
          "assets": [
            {
              "input": "./packages/next-skaffold/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/next-skaffold/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@dxs/skaffold": "workspace:*",
    "@nx/devkit": "23.1.1",
    "@swc/helpers": "~0.5.18",
    "nx": "23.1.1",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "generators": "./generators.json"
}
