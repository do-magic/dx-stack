{
  "name": "@dxs/skaffold",
  "version": "0.0.1",
  "description": "Framework-agnostic core for automated Kubernetes/Skaffold deployment via Nx sync generators",
  "license": "MIT",
  "author": "Sebastian Velten <velten.seb@web.de>",
  "homepage": "https://github.com/do-magic/dx-stack/tree/main/packages/skaffold#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/do-magic/dx-stack.git",
    "directory": "packages/skaffold"
  },
  "bugs": {
    "url": "https://github.com/do-magic/dx-stack/issues"
  },
  "keywords": [
    "nx",
    "nx-plugin",
    "kubernetes",
    "skaffold",
    "devops",
    "deployment"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@dxs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "LICENSE"
  ],
  "nx": {
    "name": "skaffold"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@nx/devkit": "^23.0.0",
    "nx": "^23.0.0"
  }
}
