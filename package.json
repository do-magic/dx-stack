{
  "name": "@dx-stack/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {},
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/plugin": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.10",
    "@vitest/ui": "~4.1.10",
    "eslint": "~10.6.0",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "sass": "1.97.2",
    "tslib": "^2.3.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.63.0",
    "verdaccio": "6.4.0",
    "vite": "^8.1.4",
    "vitest": "~4.1.10",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage",
          "scopes": [
            "@dx-stack"
          ]
        }
      },
      "local-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm nx release publish --registry=http://localhost:4873"
        }
      },
      "release-commit": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm nx release --skip-publish"
        }
      },
      "minikube": {
        "executor": "nx:run-commands",
        "options": {
          "command": "minikube start"
        }
      },
      "skaffold": {
        "continuous": true,
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "configurations": {
          "development": {
            "commands": [
              "eval $(minikube docker-env)",
              "skaffold run -f skaffold/infra.yaml",
              "skaffold dev -f skaffold/skaffold.yaml --port-forward=services"
            ],
            "parallel": false
          },
          "production": {
            "commands": [
              "eval $(minikube docker-env)",
              "skaffold run -f skaffold/infra.yaml",
              "skaffold dev -f skaffold/skaffold.yaml -p production --port-forward=services"
            ],
            "parallel": false
          }
        },
        "syncGenerators": [
          "@dx-stack/next-skaffold:sync"
        ]
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
