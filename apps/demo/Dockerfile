# syntax=docker/dockerfile:1
# Generated by @dxs/skaffold:sync. Do not edit directly — run `nx sync` to regenerate.

FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
WORKDIR /workspace
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/demo/package.json apps/demo/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS source
COPY nx.json tsconfig.base.json ./
COPY apps/demo apps/demo

FROM source AS builder
RUN --mount=type=cache,id=next-demo,target=/workspace/apps/demo/.next/cache \
    pnpm exec nx build demo --skip-sync

FROM source AS dev
ENV NODE_ENV=development
EXPOSE 3000
CMD ["pnpm", "exec", "nx", "dev", "demo", "--skip-sync"]

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /workspace/apps/demo/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/demo/.next/static ./apps/demo/.next/static
COPY --from=builder --chown=nextjs:nodejs /workspace/apps/demo/public ./apps/demo/public

USER nextjs
EXPOSE 3000

CMD ["node", "apps/demo/server.js"]
