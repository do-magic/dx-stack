# syntax=docker/dockerfile:1
# Generated by @dx-stack/skaffold:sync. Do not edit directly — run `nx sync` to regenerate.

FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
WORKDIR /workspace

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/svc/package.json apps/svc/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS source
COPY nx.json tsconfig.base.json ./
COPY apps/svc apps/svc

FROM source AS builder
RUN pnpm exec nx run svc:prune --skip-sync

FROM source AS dev
ENV NODE_ENV=development
EXPOSE 3000
CMD ["pnpm", "exec", "nx", "serve", "svc", "--skip-sync"]

FROM base AS runner
WORKDIR /workspace/apps/svc/dist
ENV NODE_ENV=production
ENV PORT=3000
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /workspace/apps/svc/dist ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile

USER nestjs
EXPOSE 3000

CMD ["node", "main.js"]
